<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<TabPane focusTraversable="false" prefHeight="500.0" prefWidth="921.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.farmingdale.csc311_maze_groupassignment.MazeTabsController">
    <tabs>
        <Tab closable="false" text="Maze 1">
            <content>
                <VBox spacing="8.0">
               <children>
                   <HBox spacing="8.0">
                     <children>
                        <Button fx:id="Robot" mnemonicParsing="false" onAction="#showRobot" text="Robot" />
                        <Button fx:id="Car" mnemonicParsing="false" onAction="#showCar" text="Car" />
                     </children>
                  </HBox>
                      <StackPane fx:id="maze1Content">
                          <fx:include source="robot.fxml" />
                      </StackPane>
               </children>
            </VBox>
            </content>
        </Tab>

        <Tab closable="false" text="Maze 2">
            <content>
                <VBox spacing="8.0">
                    <children>
                        <HBox spacing="8.0">
                            <children>
                                <Button mnemonicParsing="false"
                                        onAction="#showRobotMaze2"
                                        text="Robot" />

                                <Button mnemonicParsing="false"
                                        onAction="#showCarMaze2"
                                        text="Car" />
                            </children>
                        </HBox>

                        <StackPane fx:id="maze2Content">

                        </StackPane>
                    </children>
                </VBox>
            </content>
        </Tab>

    </tabs>
</TabPane>
