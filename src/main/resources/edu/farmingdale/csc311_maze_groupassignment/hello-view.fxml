<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="edu.farmingdale.csc311_maze_groupassignment.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id="welcomeText" text="Choose your character!"/>
    <HBox alignment="CENTER" spacing="50.0">
    <Button text="Robot" onAction="#robot"/>
    <Button text="Car!" onAction="#car"/>
    </HBox>
    <Button text="Open Mazes" onAction="#openMazeTabs"/>
</VBox>